@WebApplication_HostAddress = http://localhost:5239

GET {{WebApplication_HostAddress}}/
Accept: application/json

###

### Get all todos
GET {{WebApplication_HostAddress}}/api/v1/todos?page=0&size=20
Accept: application/json

###

### Filter todos by status
GET {{WebApplication_HostAddress}}/api/v1/todos?status=OPEN
Accept: application/json

###

### get one todo
GET {{WebApplication_HostAddress}}/api/v1/todos/1
Accept: application/json

###

### Create a todo
POST {{WebApplication_HostAddress}}/api/v1/todos
Content-Type: application/json

{
  "title": "Finish the api implementation",
  "description": "finish the tasks for the prosa api workshop",
  "dueDate": "2026-10-20T12:00:00"
}

###

### Update a todo
PUT {{WebApplication_HostAddress}}/api/v1/todos/1
Content-Type: application/json

{
  "title": "Finish the api implementation",
  "description": "finish the tasks for the prosa api workshop",
  "status": "IN_PROGRESS",
  "dueDate": "2026-10-20T12:00:00"
}

###

### Update only the status
PATCH {{WebApplication_HostAddress}}/api/v1/todos/1/status?status=DONE
Accept: application/json

###

### Delete a todo
DELETE {{WebApplication_HostAddress}}/api/v1/todos/1
Accept: application/json

###

### Test 404 handling
GET {{WebApplication_HostAddress}}/api/v1/todos/999
Accept: application/json

###

### Test validation missing title
POST {{WebApplication_HostAddress}}/api/v1/todos
Content-Type: application/json

{
  "description": "this should be rejected"
}

###

### Test validation empty title
POST {{WebApplication_HostAddress}}/api/v1/todos
Content-Type: application/json

{
  "title": ""
}

###